# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID (for slash command registration)
DISCORD_CLIENT_ID=your_client_id_here

# Discord channel ID where profits are announced
ANNOUNCE_CHANNEL_ID=your_channel_id_here

# Dashboard admin password (basic auth)
DASHBOARD_ADMIN_PASSWORD=changeme

# Dashboard port (default 3000)
DASHBOARD_PORT=3000
