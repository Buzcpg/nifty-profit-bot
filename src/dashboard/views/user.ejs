<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Dashboard</title>
  <style>
    :root {
      --bg: #0a0a0b;
      --text: #ffffff;
      --accent: #00ff88;
      --panel: #141416;
      --border: #232329;
      --muted: #9ea0a8;
    }

    body {
      margin: 0;
      padding: 24px;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    h1 {
      margin: 0 0 16px;
      color: var(--accent);
    }

    .panel {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 20px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }

    .card {
      background: #0f0f12;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px;
    }

    .label {
      color: var(--muted);
      display: block;
      margin-bottom: 6px;
      font-size: 0.9rem;
    }

    .value {
      color: var(--accent);
      font-size: 1.2rem;
      font-weight: 700;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      text-align: left;
      padding: 10px;
      border-bottom: 1px solid var(--border);
    }

    th { color: var(--muted); }

    @media (max-width: 680px) {
      body { padding: 14px; }
      table { font-size: 0.9rem; }
      th, td { padding: 8px; }
    }
  </style>
</head>
<body>
  <div class="panel">
    <h1>User Dashboard: <%= userId %></h1>
    <div class="cards">
      <div class="card">
        <span class="label">Total Profit</span>
        <span class="value"><%= stats?.totalProfit ?? stats?.total_profit ?? 0 %></span>
      </div>
      <div class="card">
        <span class="label">Trade Count</span>
        <span class="value"><%= stats?.tradeCount ?? stats?.trade_count ?? 0 %></span>
      </div>
      <div class="card">
        <span class="label">Win Rate (%)</span>
        <span class="value"><%= stats?.winRate ?? stats?.win_rate ?? 0 %></span>
      </div>
      <div class="card">
        <span class="label">Best Trade</span>
        <span class="value"><%= stats?.bestTrade ?? stats?.best_trade ?? 0 %></span>
      </div>
    </div>
  </div>

  <div class="panel">
    <h2>Trades</h2>
    <table>
      <thead>
        <tr>
          <th>Collection</th>
          <th>Amount</th>
          <th>Currency</th>
          <th>USD Value</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% ((stats && stats.trades) || []).forEach((trade) => { %>
          <tr>
            <td><%= trade.collection || 'N/A' %></td>
            <td><%= trade.amount ?? 0 %></td>
            <td><%= trade.currency || 'N/A' %></td>
            <td><%= trade.usd_value ?? 0 %></td>
            <td><%= trade.date || trade.created_at || 'N/A' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
